APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Only behind a hosting proxy: the header in which the host's edge reports each visitor's address
# (CF-Connecting-IP on Render). Never name a header a visitor can set, such as X-Forwarded-For.
# CLIENT_ADDRESS_HEADER=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL preparation only; keep the active database until cutover is approved.
# DB_SEARCH_PATH=elancer
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/absolute/path/to/supabase-ca.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Live messages and notifications: set BROADCAST_CONNECTION=reverb, fill the three
# REVERB_APP_* values with any private random strings and run php artisan reverb:start.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Uploaded files: "local" keeps them in storage/app, "s3" uses the two private buckets below.
UPLOADS_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_BUCKET=
AWS_IDENTITY_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional super-admin bootstrap for migrate:fresh --seed (keep real values private).
ELANCER_SUPER_ADMIN_EMAIL=
ELANCER_SUPER_ADMIN_PASSWORD_HASH=

# Profile photos require an accepting Sightengine moderation workflow.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_PROFILE_WORKFLOW=

# Demo entry on the login and register pages: one prepared account per role. A button shows only
# where its account exists. Set DEMO_SIGN_IN=false to switch the entry off.
DEMO_SIGN_IN=true
DEMO_CLIENT_EMAIL=client-01@demo.elancer.test
DEMO_FREELANCER_EMAIL=freelancer-01@demo.elancer.test
# Every account on this reserved address domain is a demo account; nobody can register on it, and demo
# accounts and members never hire each other. Demo visitors can act among demo accounts once a super
# administrator saves a starting point on /admin/demo; DEMO_ACTIONS=false keeps them view-only.
DEMO_DOMAIN=demo.elancer.test
DEMO_ACTIONS=true
# A reset to the starting point runs when a visitor enters a demo nobody changed for this many minutes,
# or one that has stayed changed for this many hours.
DEMO_RESET_IDLE_MINUTES=30
DEMO_RESET_MAX_HOURS=12

# Optional social sign-in. Register exact callbacks with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Contract funding uses test providers only; no live payment path exists.
# Stripe test-mode secret key (must start with sk_test_; live keys are refused).
STRIPE_TEST_SECRET_KEY=
# Optional Stripe webhook signing secret (whsec_...); /payments/webhooks/stripe stays off without it.
STRIPE_WEBHOOK_SECRET=
# Moyasar (Saudi Arabia) test secret key (must start with sk_test_; live keys are refused).
MOYASAR_TEST_SECRET_KEY=
# Offline stand-in for automated tests; keep false so members only see real test providers.
PAYMENT_SIMULATOR=false
