APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL preparation only; keep the active database until cutover is approved.
# DB_SEARCH_PATH=elancer
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/absolute/path/to/supabase-ca.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Live messages and notifications: set BROADCAST_CONNECTION=reverb, fill the three
# REVERB_APP_* values with any private random strings and run php artisan reverb:start.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional super-admin bootstrap for migrate:fresh --seed (keep real values private).
ELANCER_SUPER_ADMIN_EMAIL=
ELANCER_SUPER_ADMIN_PASSWORD_HASH=

# Profile photos require an accepting Sightengine moderation workflow.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_PROFILE_WORKFLOW=

# Optional social sign-in. Register exact callbacks with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Contract funding uses test providers only; no live payment path exists.
# Stripe test-mode secret key (must start with sk_test_; live keys are refused).
STRIPE_TEST_SECRET_KEY=
# Moyasar (Saudi Arabia) test secret key (must start with sk_test_; live keys are refused).
MOYASAR_TEST_SECRET_KEY=
# PayPal Sandbox app credentials (developer.paypal.com, Sandbox tab).
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
# Offline stand-in for automated tests; keep false so members only see real test providers.
PAYMENT_SIMULATOR=false
